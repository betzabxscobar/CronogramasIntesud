generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AcademicPeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum Shift {
  DAY
  NIGHT
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  CANCELLED
}

enum SpaceType {
  CLASSROOM
  LABORATORY
}

enum SpaceStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
  INACTIVE
}

enum ReservationType {
  CLASS
  EVENT
  MAINTENANCE
  ADMINISTRATIVE_BLOCK
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  INVALID
  READY
  IMPORTED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
}

model User {
  id               String              @id @default(uuid()) @db.Uuid
  nationalId       String              @unique @map("national_id")
  firstNames       String              @map("first_names")
  lastNames        String              @map("last_names")
  email            String              @unique
  passwordHash     String?             @map("password_hash")
  role             UserRole
  status           RecordStatus        @default(ACTIVE)
  lastLoginAt      DateTime?           @map("last_login_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  careers          CoordinatorCareer[]
  sessions         UserSession[]
  loginCodes       LoginCode[]
  createdVersions  ScheduleVersion[]   @relation("VersionCreatedBy")
  modifiedVersions ScheduleVersion[]   @relation("VersionModifiedBy")
  publishedVersions ScheduleVersion[]  @relation("VersionPublishedBy")
  reservations     SpaceReservation[]
  imports          ImportJob[]
  auditLogs        AuditLog[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model LoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid @map("user_id")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  requestIp  String?   @map("request_ip")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("login_codes")
}

model Career {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  slug               String              @unique
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  coordinators       CoordinatorCareer[]
  professors         ProfessorCareer[]
  levels             Level[]
  subjects           Subject[]
  allowedSpaces      SpaceCareer[]
  reservations       SpaceReservation[]
  imports            ImportJob[]

  @@map("careers")
}

model CoordinatorCareer {
  userId     String   @db.Uuid @map("user_id")
  careerId   String   @db.Uuid @map("career_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Restrict)

  @@id([userId, careerId])
  @@index([careerId])
  @@map("coordinator_careers")
}

model FileAsset {
  id           String    @id @default(uuid()) @db.Uuid
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at")
  professor    Professor?

  @@map("file_assets")
}

model Professor {
  id                   String            @id @default(uuid()) @db.Uuid
  nationalId           String?           @unique @map("national_id")
  firstNames           String            @map("first_names")
  lastNames            String            @map("last_names")
  professionalTitle    String?           @map("professional_title")
  scheduleColor        String            @default("#A9CBE4") @db.VarChar(7) @map("schedule_color")
  academicBiography    String?           @db.VarChar(800) @map("academic_biography")
  publicProfileEnabled Boolean           @default(true) @map("public_profile_enabled")
  photoAssetId         String?           @unique @db.Uuid @map("photo_asset_id")
  status               RecordStatus      @default(ACTIVE)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  photo                FileAsset?        @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  careers              ProfessorCareer[]
  scheduleBlocks       ScheduleBlock[]
  availabilities       ProfessorAvailability[]

  @@index([lastNames, firstNames])
  @@map("professors")
}

model ProfessorCareer {
  professorId String       @db.Uuid @map("professor_id")
  careerId    String       @db.Uuid @map("career_id")
  status      RecordStatus @default(ACTIVE)
  linkedAt    DateTime     @default(now()) @map("linked_at")
  professor   Professor    @relation(fields: [professorId], references: [id], onDelete: Restrict)
  career      Career       @relation(fields: [careerId], references: [id], onDelete: Restrict)

  @@id([professorId, careerId])
  @@index([careerId, status])
  @@map("professor_careers")
}

model ProfessorAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  professorId String    @db.Uuid @map("professor_id")
  dayOfWeek   DayOfWeek @map("day_of_week")
  startTime   DateTime  @db.Time(0) @map("start_time")
  endTime     DateTime  @db.Time(0) @map("end_time")
  available   Boolean   @default(true)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId, dayOfWeek])
  @@map("professor_availabilities")
}

model AcademicPeriod {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @unique
  startDate DateTime             @db.Date @map("start_date")
  endDate   DateTime             @db.Date @map("end_date")
  status    AcademicPeriodStatus @default(DRAFT)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  courses   AcademicCourse[]
  imports   ImportJob[]

  @@map("academic_periods")
}

model Level {
  id        String           @id @default(uuid()) @db.Uuid
  careerId  String           @db.Uuid @map("career_id")
  name      String
  order     Int
  status    RecordStatus     @default(ACTIVE)
  career    Career           @relation(fields: [careerId], references: [id], onDelete: Restrict)
  subjects  Subject[]
  courses   AcademicCourse[]

  @@unique([careerId, name])
  @@unique([careerId, order])
  @@map("levels")
}

model Subject {
  id                         String          @id @default(uuid()) @db.Uuid
  careerId                   String          @db.Uuid @map("career_id")
  levelId                    String?         @db.Uuid @map("level_id")
  code                       String?
  name                       String
  weeklyHours                Int?            @map("weekly_hours")
  requiresIndividualComputer Boolean         @default(false) @map("requires_individual_computer")
  status                     RecordStatus    @default(ACTIVE)
  career                     Career          @relation(fields: [careerId], references: [id], onDelete: Restrict)
  level                      Level?           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  scheduleBlocks             ScheduleBlock[]

  @@unique([careerId, code])
  @@index([careerId, levelId, status])
  @@map("subjects")
}

model AcademicCourse {
  id           String         @id @default(uuid()) @db.Uuid
  periodId     String         @db.Uuid @map("period_id")
  levelId      String         @db.Uuid @map("level_id")
  name         String
  studentCount Int?           @map("student_count")
  status       RecordStatus   @default(ACTIVE)
  period       AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  level        Level          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  schedules    Schedule[]

  @@unique([periodId, levelId])
  @@index([periodId, status])
  @@map("academic_courses")
}

model AcademicSpace {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  code             String                @unique
  location         String?
  type             SpaceType
  peopleCapacity   Int?                  @map("people_capacity")
  studentComputers Int?                  @map("student_computers")
  teacherComputers Int?                  @map("teacher_computers")
  hasProjector     Boolean               @default(false) @map("has_projector")
  hasDigitalBoard  Boolean               @default(false) @map("has_digital_board")
  status           SpaceStatus           @default(AVAILABLE)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  careers          SpaceCareer[]
  scheduleBlocks   ScheduleBlock[]
  reservations     SpaceReservation[]
  unavailabilities SpaceUnavailability[]

  @@index([type, status])
  @@map("academic_spaces")
}

model SpaceCareer {
  spaceId  String        @db.Uuid @map("space_id")
  careerId String        @db.Uuid @map("career_id")
  space    AcademicSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  career   Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@id([spaceId, careerId])
  @@index([careerId])
  @@map("space_careers")
}

model SpaceUnavailability {
  id        String        @id @default(uuid()) @db.Uuid
  spaceId   String        @db.Uuid @map("space_id")
  startsAt  DateTime      @map("starts_at")
  endsAt    DateTime      @map("ends_at")
  reason    String
  space     AcademicSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, startsAt, endsAt])
  @@map("space_unavailabilities")
}

model Schedule {
  id        String            @id @default(uuid()) @db.Uuid
  courseId  String            @db.Uuid @map("course_id")
  shift     Shift
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  course    AcademicCourse    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  versions  ScheduleVersion[]
  modules   ScheduleModule[]

  @@unique([courseId, shift])
  @@map("schedules")
}

model ScheduleModule {
  id           String   @id @default(uuid()) @db.Uuid
  scheduleId   String   @db.Uuid @map("schedule_id")
  moduleNumber Int      @map("module_number")
  startDate    DateTime @db.Date @map("start_date")
  endDate      DateTime @db.Date @map("end_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, moduleNumber])
  @@map("schedule_modules")
}

model ScheduleVersion {
  id           String         @id @default(uuid()) @db.Uuid
  scheduleId   String         @db.Uuid @map("schedule_id")
  version      Int
  status       ScheduleStatus @default(DRAFT)
  reason       String?
  createdById  String         @db.Uuid @map("created_by_id")
  modifiedById String         @db.Uuid @map("modified_by_id")
  publishedById String?       @db.Uuid @map("published_by_id")
  publishedAt  DateTime?      @map("published_at")
  unpublishedAt DateTime?     @map("unpublished_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  schedule     Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  modifiedBy   User           @relation("VersionModifiedBy", fields: [modifiedById], references: [id], onDelete: Restrict)
  publishedBy  User?          @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  blocks       ScheduleBlock[]

  @@unique([scheduleId, version])
  @@index([scheduleId, status])
  @@map("schedule_versions")
}

model ScheduleBlock {
  id            String          @id @default(uuid()) @db.Uuid
  versionId     String          @db.Uuid @map("version_id")
  subjectId     String          @db.Uuid @map("subject_id")
  professorId   String          @db.Uuid @map("professor_id")
  spaceId       String?         @db.Uuid @map("space_id")
  dayOfWeek     DayOfWeek       @map("day_of_week")
  startTime     DateTime        @db.Time(0) @map("start_time")
  endTime       DateTime        @db.Time(0) @map("end_time")
  validFrom     DateTime?       @db.Date @map("valid_from")
  validUntil    DateTime?       @db.Date @map("valid_until")
  moduleNumber  Int?            @map("module_number")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  version       ScheduleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  professor     Professor       @relation(fields: [professorId], references: [id], onDelete: Restrict)
  space         AcademicSpace?  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@index([versionId, dayOfWeek, startTime, endTime])
  @@index([professorId, dayOfWeek, startTime, endTime])
  @@index([spaceId, dayOfWeek, startTime, endTime])
  @@map("schedule_blocks")
}

model SpaceReservation {
  id          String          @id @default(uuid()) @db.Uuid
  spaceId     String          @db.Uuid @map("space_id")
  careerId    String?         @db.Uuid @map("career_id")
  createdById String          @db.Uuid @map("created_by_id")
  type        ReservationType
  title       String
  description String?
  responsible String?
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime        @map("ends_at")
  cancelledAt DateTime?       @map("cancelled_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  space       AcademicSpace   @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  career      Career?         @relation(fields: [careerId], references: [id], onDelete: Restrict)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([spaceId, startsAt, endsAt])
  @@index([careerId, startsAt])
  @@map("space_reservations")
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid @map("user_id")
  careerId    String       @db.Uuid @map("career_id")
  // Periodo al que pertenecen los bloques de horario, cuando la importacion
  // los incluye. Opcional porque una importacion puede traer solo datos maestros.
  periodId    String?      @db.Uuid @map("period_id")
  fileName    String       @map("file_name")
  status      ImportStatus @default(UPLOADED)
  totalRows   Int          @default(0) @map("total_rows")
  validRows   Int          @default(0) @map("valid_rows")
  warningRows Int          @default(0) @map("warning_rows")
  errorRows   Int          @default(0) @map("error_rows")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  period      AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  career      Career       @relation(fields: [careerId], references: [id], onDelete: Restrict)
  rows        ImportRow[]

  @@index([careerId, createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id          String          @id @default(uuid()) @db.Uuid
  importJobId String          @db.Uuid @map("import_job_id")
  sheetName   String          @map("sheet_name")
  rowNumber   Int             @map("row_number")
  status      ImportRowStatus
  rawData     Json            @map("raw_data")
  messages    Json
  importJob   ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, status])
  @@map("import_rows")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  reason       String?
  previousData Json?    @map("previous_data")
  newData      Json?    @map("new_data")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
